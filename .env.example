# Copy to .env and adjust. Never commit .env.
# Local development. Production: DEBUG=False (the default), a long random SECRET_KEY,
# real ALLOWED_HOSTS, CORS_ALLOWED_ORIGINS / CSRF_TRUSTED_ORIGINS for the frontend and admin.
DEBUG=True
SECRET_KEY=change-me-in-production
# Local docker-compose maps host port 5433 to avoid clashing with any other Postgres
DATABASE_URL=postgres://yap:yap@localhost:5433/yap
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=https://app.example.com
# CSRF_TRUSTED_ORIGINS=https://api.example.com
# SECURE_SSL_REDIRECT=True   # only applies when DEBUG=False
# SECURE_HSTS_SECONDS=2592000
# LOG_LEVEL=INFO
