# Production settings for docker-compose.prod.yml. Copy to .env.prod and fill in.
# Never commit .env.prod.
SECRET_KEY=replace-with-a-long-random-string
POSTGRES_USER=yap
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=yap
DATABASE_URL=postgres://yap:replace-with-a-strong-password@db:5432/yap
ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
NUM_PROXIES=1
WEB_CONCURRENCY=3
EMAIL_URL=smtp+tls://user:password@smtp.example.com:587
DEFAULT_FROM_EMAIL=YAP <no-reply@example.com>
PASSWORD_RESET_URL=https://app.example.com/reset-password
# uploaded files: local (the media volume) or s3 (a private bucket)
FILE_STORAGE=local
# FILE_STORAGE=s3
# S3_BUCKET=yap-files
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com   # blank for AWS
# S3_REGION=auto
# LOG_LEVEL=INFO
# SECURE_HSTS_SECONDS=2592000
